@startuml current_architecture

class "RfmActionServer" as RfmActionServer {
  _model_port : ModelPort
  _action_port : ActionPort
  move_from_prompt_callback(goal_handle: MoveFromPrompt.Goal) -> MoveFromPrompt.Result
  _move_from_prompt(prompt: str) -> RfmControlStatusCode
}

package "Model Adapter" {
  abstract class "ModelPort" as ModelPort {
    _observation_handler : Sequence[ObservationHandler]
    {abstract}model_client : ModelClient[ModelActionType]
    {abstract}model_input_mapper : ModelInputMapper
    {abstract}model_output_mapper : ModelOutputMapper[ModelOutputType]
    observation_handler : Sequence[ObservationHandler]
    {abstract}get_action(prompt: str) -> Sequence[RobotAction]
    get_concat_observation() -> Observations
  }
  
  abstract class "ModelClient<ModelActionType>" as ModelClient {
    {abstract}get_action(observation: dict[str, Any], prompt: str) -> ModelActionType
  }
  
  abstract class "Gr00tModelClient" as Gr00tModelClient {
    <<type alias>>
    Gr00tAction = dict[str, np.ndarray]
  }
  
  abstract class "OctoModelClient" as OctoModelClient {
    <<type alias>>
    OctoAction = list[list[list[float]]]
  }
  
  package "mapper.input" {
    abstract class "ModelInputMapper" as ModelInputMapper {
      {abstract}transform_observation(observations: Observations) -> dict[str, np.ndarray]
    }
    
    class "Gr00tInputMapper" as Gr00tInputMapper {
      robot_configs : Sequence[RobotConfig]
      image_configs : Sequence[ImageConfig]
      transform_observation(observations: Observations) -> dict[str, np.ndarray]
    }
    
    class "OctoInputMapper" as OctoInputMapper {
      robot_configs : Sequence[RobotConfig]
      image_configs : Sequence[ImageConfig]
      transform_observation(observations: Observations) -> dict[str, np.ndarray]
    }
    
    note top of ModelInputMapper
      Transforms type-safe Observations DTOs to model-specific format.
      Provides symmetry with ModelOutputMapper.
      
      Data flow: 
      ObservationHandlers → Observations DTO → ModelInputMapper 
      → Model-specific dict → ModelClient
      
      Handles:
      - Joint data scaling (GR00T: radians * 100/π, Octo: raw radians)
      - Image resizing and transformation
      - Model-specific metadata (e.g., timestep_pad_mask for Octo)
    end note
  }
  
  package "mapper.output" {
    abstract class "ModelOutputMapper<ModelOutputType>" as ModelOutputMapper {
      {abstract}to_action(model_output: ModelOutputType) -> Sequence[RobotAction]
    }
    
    class "Gr00tJointStateMapper" as Gr00tJointStateMapper {
      to_action(model_output) -> Sequence[RobotAction]
    }
    
    class "Gr00tJointStateMapperRTC" as Gr00tJointStateMapperRTC {
      to_action(model_output) -> Sequence[RobotAction]
    }
    
    class "OctoDeltaEndeffectorMapper" as OctoDeltaEndeffectorMapper {
      to_action(model_output) -> Sequence[RobotAction]
    }
    
    note top of ModelOutputMapper
      Transforms model-specific output to RobotActions.
      Provides symmetry with ModelInputMapper.
      
      Data flow:
      ModelClient → Model Output → ModelOutputMapper 
      → RobotActions → ActionPort
    end note
  }
}

package "Observation Handler" {
  abstract class "ObservationHandler" as ObservationHandler {
    {abstract}get_observations() -> Observations
    {abstract}create_subscription(node: Node) -> None
  }
  
  class "ImageHandler" as ImageHandler {
    image_configs : Sequence[ImageConfig]
    get_observations() -> Observations
    create_subscription(node: Node) -> None
  }
  
  class "JointStateHandler" as JointStateHandler {
    robots : Sequence[RobotConfig]
    get_observations() -> Observations
    get_current_joint_state() -> RosJointState
    create_subscription(node: Node) -> None
  }
  
  note right of ObservationHandler
    Returns type-safe Observations DTOs.
    Handlers provide partial observations:
    - JointStateHandler: populates robots
    - ImageHandler: populates images
    ModelPort merges into complete Observations.
  end note
}

package "Action Adapter" {
  abstract class "ActionPort" as ActionPort {
    {abstract}robots : Sequence[Robot]
    {abstract}joint_state_handler : JointStateHandler
    {abstract}move(node: Node, actions: Sequence[RobotAction], action_execution_horizon: int) -> RfmControlStatusCode
  }
  
  class "Robot<CommandType>" as Robot {
    prefix : str
    action_mapper : ActionMapper<CommandType>
    arm_action_executor : MotionExecutor<CommandType>
    gripper_action_executor : GripperActionExecutor
    _current_actions : dict[int, RobotAction]
    __init__(prefix: str, action_mapper: ActionMapper<CommandType>, arm_action_executor: MotionExecutor<CommandType>, gripper_action_executor: GripperActionExecutor) -> None
    set_actions(actions: Sequence[RobotAction]) -> None
    get_action(timestep: int) -> RobotAction | None
  }
  
  abstract class "ActionMapper<CommandType>" as ActionMapper {
    {abstract}map_action_to_executor_input(action: ArmAction, state: JointState | None) -> CommandType
  }
  
  note right of ActionMapper
    CommandType is defined in MotionExecutor and represents
    the command format expected by the executor
    (e.g., JointTrajectory for FollowJointTrajectory controller).
    
    state is optional: stateless mappers
    (e.g., AbsoluteJointActionMapper) don't need it,
    stateful mappers (e.g., DeltaEndeffectorActionMapper
    with IK) require it.
  end note
}

package "Action Executor" {
  abstract class "MotionExecutor<CommandType>" as MotionExecutor {
    {abstract}execute_async(command: CommandType, node: Node) -> Future
    execute_sync(command: CommandType, node: Node, timeout_sec: float) -> bool
  }
  
  class "JointTrajectoryActionExecutor" as JointTrajectoryActionExecutor {
    topic_name : str
    execute_async(command: JointTrajectory, node: Node) -> Future
  }
  
  class "GripperActionExecutor" as GripperActionExecutor {
    topic_name : str
    execute_async(command: GripperCommandMessage, node: Node) -> Future
  }
}

package "Domain Model" {
  abstract class "RobotAction" as RobotAction {
    robot_prefix : str
    timestep_id : int
    arm_action : ArmAction
    gripper_action : GripperAction
  }
  
  abstract class "ArmAction" as ArmAction {
    time_between_goals : float
  }
  
  class "AbsoluteJointStateAction" as AbsoluteJointStateAction {
    joint_states : np.ndarray
    joint_names : list[str] = []
    time_between_goals : float
  }
  
  class "DeltaEndeffectorAction" as DeltaEndeffectorAction {
    position : np.ndarray
    orientation : np.ndarray
    time_between_goals : float = 0.5
  }
  
  abstract class "GripperAction" as GripperAction {
  }
  
  class "SynchronousGripperAction" as SynchronousGripperAction {
    gripper_aperture : float
  }
}

package "Config" {
  abstract class "ModelConfig" as ModelConfig {
    image_configs : list[ImageConfig]
    robot_configs : list[RobotConfig]
  }
  
  class "RobotConfig" as RobotConfig {
    prefix : str
    frame_id : str
    group_name : str
    arm_config : ActuatorConfig
    gripper_config : ActuatorConfig
    joint_state_topic : str
    time_between_goals : float
  }
}

' Relationships
RfmActionServer o-- ModelPort : _model_port
RfmActionServer o-- ActionPort : _action_port

ModelPort o-- ModelClient : model_client
ModelPort *-- ModelInputMapper : model_input_mapper
ModelPort *-- ModelOutputMapper : model_output_mapper
ModelPort *-- ObservationHandler : observation_handler
ModelPort ..> Observations : merges from handlers

ModelInputMapper ..> Observations : consumes
ModelInputMapper --> RobotConfig : uses
ModelInputMapper --> ImageConfig : uses

ModelClient <|-- Gr00tModelClient : implements
ModelClient <|-- OctoModelClient : implements

ModelInputMapper <|-- Gr00tInputMapper : implements
ModelInputMapper <|-- OctoInputMapper : implements

ModelOutputMapper <|-- Gr00tJointStateMapper : implements
ModelOutputMapper <|-- Gr00tJointStateMapperRTC : implements
ModelOutputMapper <|-- OctoDeltaEndeffectorMapper : implements

ObservationHandler <|-- ImageHandler
ObservationHandler <|-- JointStateHandler

JointStateHandler --> RobotConfig : robots

ActionPort o-- Robot : robots
ActionPort o-- JointStateHandler : joint_state_handler

Robot o-- ActionMapper : action_mapper
Robot o-- MotionExecutor : arm_action_executor
Robot o-- GripperActionExecutor : gripper_action_executor
Robot --> RobotConfig : robot_config

RobotAction o-- ArmAction : arm_action
RobotAction o-- GripperAction : gripper_action

ArmAction <|-- AbsoluteJointStateAction
ArmAction <|-- DeltaEndeffectorAction

GripperAction <|-- SynchronousGripperAction

MotionExecutor <|-- JointTrajectoryActionExecutor
MotionExecutor <|-- GripperActionExecutor

ModelConfig *-- RobotConfig : robot_configs

' Example implementations (shown with dashed lines)
ModelPort <|.. "Gr00tAdapter\nOctoAdapter" : implements
Gr00tModelClient <|.. "Gr00tClient\nGr00tClientMock" : implements
OctoModelClient <|.. "OctoClient\nOctoClientMock" : implements
ActionPort <|.. "FollowJointTrajectoryAdapter" : implements
ActionMapper <|.. "AbsoluteJointActionMapper" : implements
ActionMapper <|.. "DeltaEndeffectorActionMapper" : implements

note right of Gr00tInputMapper
  Transforms Observations DTO to GR00T format:
  - Joint scaling: radians * 100 / π
  - Image resizing per ImageConfig
  - Maps to model-specific keys
  Symmetrical to Gr00tJointStateMapper output.
end note

note right of OctoInputMapper
  Transforms Observations DTO to Octo format:
  - Passes joint values unchanged (radians)
  - Image resizing per ImageConfig
  - Adds timestep_pad_mask metadata
end note

note right of Gr00tJointStateMapper
  Transforms GR00T policy scale to radians:
  value * π / 100
  Inverse of Gr00tInputMapper.
end note

note right of OctoDeltaEndeffectorMapper
  Maps Octo delta endeffector outputs
  to robot actions. No scaling needed.
end note

note right of AbsoluteJointActionMapper
  Stateless mapper: ActionMapper<JointTrajectory>
  Maps absolute joint positions directly
  without needing current state.
end note

note right of DeltaEndeffectorActionMapper
  Stateful mapper: ActionMapper<JointTrajectory>
  Maps delta endeffector poses using FK/IK.
  Requires current joint state.
end note

note bottom of JointStateHandler
  Returns Observations DTO with:
  - robots: list[RobotState] (populated)
  - images: {} (empty, default)
  
  Joint values in radians (model-agnostic).
  Uses RosJointState (sensor_msgs.msg) internally.
end note

note bottom of ImageHandler
  Returns Observations DTO with:
  - robots: [] (empty, default)
  - images: dict[str, np.ndarray] (populated)
  
  Raw decoded images without resizing.
  Resizing is model-specific (done in ModelInputMapper).
end note

@enduml
